<idea-plugin>
    <id>io.codelaser.maddi</id>
    <name>maddi</name>
    <vendor url="https://codelaser.io">CodeLaser</vendor>
    <!-- The first 40 characters become the Marketplace preview card: plain words, no jargon. The change notes are
         filled in at build time from docs/ide-changelog.md (patchPluginXml). -->
    <description><![CDATA[
        <p>Immutability, modification and nullability analysis for Java and Kotlin, shown in the editor.</p>
        <p><b>maddi</b> analyses a whole project and shows its conclusions beside each declaration, as the annotations
        you would write by hand: whether a type is immutable or a container, whether a method modifies its object or
        its arguments, whether a field or parameter can be null, whether an object exposes its internals.</p>
        <ul>
            <li>Inline hints and gutter icons with the computed annotations (<code>@ImmutableContainer</code>,
                <code>@NotModified</code>, <code>@Independent</code>, <code>@Nullable</code>, …).</li>
            <li>Contracts: annotations you write yourself are checked, and a violation is marked in the code with the
                chain of reasons that led to it.</li>
            <li>A tool window with the run's progress, the findings, and a run log.</li>
        </ul>
        <p><b>Requirements.</b> A JDK 25 or later, which the plugin picks from the IDE's JDKs (Settings → Tools →
        maddi). The analysis runs in a separate process, the bundled maddi daemon, on that JDK; nothing leaves your
        machine. Kotlin sources need the Kotlin front end, a separate download the plugin offers the first time a
        project has Kotlin sources.</p>
        <p>Start with <i>Tools → Analyze with maddi</i>. Documentation and source:
        <a href="https://github.com/CodeLaser/maddi">github.com/CodeLaser/maddi</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <!-- optional: on Kotlin sources too, when the Kotlin plugin is there (the analysis needs the downloaded
         Kotlin front end as well; see MaddiKotlinFrontEnd) -->
    <depends optional="true" config-file="maddi-kotlin.xml">org.jetbrains.kotlin</depends>

    <!-- ⚠ HERE, not in maddi-kotlin.xml: the Kotlin plugin reads it to decide whether to load that file at all, and
         in its default K2 mode it skips the file of a plugin that does not declare it ("not compatible with the
         Kotlin plugin in the K2 mode"). Only PSI is used (no resolve), which both modes provide alike. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="maddi" displayType="BALLOON"/>
        <!-- @Service classes (MaddiSettings, MaddiAnalysisService) auto-register. -->
        <externalAnnotator language="JAVA"
                           implementationClass="io.codelaser.maddi.ide.plugin.ui.MaddiExternalAnnotator"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                           implementationClass="io.codelaser.maddi.ide.plugin.ui.MaddiLineMarkerProvider"/>
        <toolWindow id="maddi" anchor="bottom"
                    factoryClass="io.codelaser.maddi.ide.plugin.ui.MaddiToolWindowFactory"/>
        <codeInsight.declarativeInlayProvider language="JAVA"
                    implementationClass="io.codelaser.maddi.ide.plugin.ui.MaddiInlayProvider"
                    providerId="maddi.hints"
                    isEnabledByDefault="true"
                    group="OTHER_GROUP"
                    bundle="messages.MaddiBundle"
                    nameKey="inlay.maddi.name"
                    descriptionKey="inlay.maddi.description"/>
        <applicationConfigurable parentId="tools"
                    id="maddi.settings"
                    displayName="maddi"
                    instance="io.codelaser.maddi.ide.plugin.settings.MaddiConfigurable"/>
    </extensions>

    <projectListeners>
        <listener class="io.codelaser.maddi.ide.plugin.analysis.MaddiCompilationListener"
                  topic="com.intellij.openapi.compiler.CompilationStatusListener"/>
    </projectListeners>

    <actions>
        <action id="maddi.AnalyzeProject"
                class="io.codelaser.maddi.ide.plugin.action.AnalyzeWithMaddiAction"
                text="Analyze with maddi"
                description="Compile the project and run a whole-project maddi analysis">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="maddi.TranslateToKotlin"
                class="io.codelaser.maddi.ide.plugin.action.TranslateToKotlinAction"
                text="Translate to Kotlin with maddi"
                description="Translate Java to Kotlin with maddi's translator, which uses the analysis's verdicts: a module as one Kotlin code base, or files as a preview">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
        </action>
        <action id="maddi.StopAnalysis"
                class="io.codelaser.maddi.ide.plugin.action.StopMaddiAnalysisAction"
                text="Stop maddi Analysis"
                description="Stop the running maddi analysis"
                icon="AllIcons.Actions.Suspend">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
