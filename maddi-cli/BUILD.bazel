load("@rules_java//java:defs.bzl", "java_binary")
load("//:platform.bzl", "OPENJDK_JAVAC_EXPORTS")

# Not built by CI (which runs Gradle only); kept in step with build.gradle.kts by hand.
# 'application' plugin equivalent: the openjdk-parser-based `maddi` CLI
java_binary(
    name = "maddi",
    main_class = "io.codelaser.maddi.run.openjdkmain.Main",
    visibility = ["//visibility:public"],
    jvm_flags = OPENJDK_JAVAC_EXPORTS,
    runtime_deps = [
        "//maddi-run-openjdk",
        "//maddi-run-analysis",  # the AnalysisEngine the driver loads
        "//maddi-aapi-archive",  # runtimeOnly: shipped analysis-result jars
    ],
)
